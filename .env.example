# Banco de dados — agora precisa ser Postgres (SQLite não funciona na Vercel).
# Crie grátis em https://neon.tech ou https://supabase.com e cole a connection string aqui:
DATABASE_URL="postgresql://usuario:senha@host:5432/raizes_db?sslmode=require"

# NextAuth
AUTH_SECRET="gere-com: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Login com Google (OPCIONAL). Sem preencher, o botão "Entrar com Google" fica
# desabilitado e o site funciona normal só com e-mail/senha.
# Crie em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Upload de fotos de produto na Vercel (OPCIONAL localmente, OBRIGATÓRIO em produção).
# Crie um Blob Store em: Vercel → seu projeto → Storage → Create Database → Blob
# A Vercel preenche essa variável sozinha quando você conecta o Blob Store ao projeto.
BLOB_READ_WRITE_TOKEN=""

# Número do WhatsApp da loja (com DDI+DDD, sem espaços)
WHATSAPP_NUMBER="5511978912732"

# Credenciais do admin criadas automaticamente pelo seed
ADMIN_EMAIL="gui9451aa@gmail.com"
ADMIN_PASSWORD="12345678"
